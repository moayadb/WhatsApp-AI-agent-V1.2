rules_version = '2';

// WhatsApp Insights — Firestore security rules.
//
// The app is read-mostly. The only write it performs is flipping an alert's
// `status` (plus the `completion_date` stamp that goes with it). Alert
// documents themselves are created by n8n with a service account, which
// bypasses these rules entirely — so client create/delete stay closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAllowedUser() {
      return signedIn()
             && exists(/databases/$(database)/documents/allowed_users/$(request.auth.uid))
             && get(/databases/$(database)/documents/allowed_users/$(request.auth.uid)).data.enabled != false
             && get(/databases/$(database)/documents/allowed_users/$(request.auth.uid)).data.email
                == request.auth.token.email;
    }

    // -----------------------------------------------------------------
    // Sign-in allowlist. Documents are keyed by Firebase Auth UID. A user can
    // read only their own profile; administrators can manage the collection.
    //
    // Writes are admin-only. `admins/{uid}` is maintained from the Firebase
    // console (or a service account); no client can grant itself entry.
    // -----------------------------------------------------------------
    match /allowed_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------
    // Push tokens, one document per device install.
    //
    // Clients may only write a row stamped with their OWN address, so a
    // signed-in user cannot point somebody else's device record at a token
    // they control. No client may read the collection at all — the whole
    // point of it is the token list, and that is for the server only.
    //
    // The sender (n8n / a Cloud Function) uses a service account, which
    // bypasses these rules entirely, so `allow read: if false` costs it
    // nothing.
    // -----------------------------------------------------------------
    match /device_tokens/{deviceId} {
      allow read: if false;
      allow create: if isAllowedUser()
                    && request.resource.data.keys().hasOnly([
                      'token', 'owner_uid', 'email', 'platform', 'updated_at'
                    ])
                    && request.resource.data.token is string
                    && request.resource.data.owner_uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.platform in ['android', 'ios']
                    && request.resource.data.updated_at is timestamp;
      allow update: if isAllowedUser()
                    && resource.data.owner_uid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'token', 'owner_uid', 'email', 'platform', 'updated_at'
                    ])
                    && request.resource.data.token is string
                    && request.resource.data.owner_uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.platform in ['android', 'ios']
                    && request.resource.data.updated_at is timestamp;
      allow delete: if isAllowedUser()
                    && resource.data.owner_uid == request.auth.uid;
    }

    // Admin registry — readable only by admins, never client-writable.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /alerts/{alertId} {
      // Customer-derived data is available only to explicitly allowed users.
      allow read: if isAllowedUser();

      // The only permitted write: a status transition, optionally carrying
      // the completion_date stamp. Nothing else in the document may change
      // in the same request.
      allow update: if isAllowedUser() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'completion_date']) &&
        request.resource.data.status in ['new', 'done', 'ignored'] &&
        // done  -> completion_date must be a timestamp
        // other -> completion_date must be absent or null (revert clears it)
        (
          (request.resource.data.status == 'done'
            && request.resource.data.completion_date is timestamp)
          ||
          (request.resource.data.status != 'done'
            && (!('completion_date' in request.resource.data)
                || request.resource.data.completion_date == null))
        );

      allow create, delete: if false;
    }

    // Anything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
