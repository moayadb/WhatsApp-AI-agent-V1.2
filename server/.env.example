# ---------------------------------------------------------------------------
# Multi-Channel AI Analyzer — server environment
# Copy to `.env` on the Contabo box and fill in. Never commit the filled file.
# ---------------------------------------------------------------------------

# What Caddy serves. Use a bare `:80` to run locally over plain HTTP with no
# certificate; use the public hostname (app.example.com) in production, where
# Caddy obtains and renews TLS automatically.
APP_DOMAIN=:80

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=analyzer
# Compose-internal DSN. Services reach the DB by service name, not localhost.
DATABASE_URL=postgres://analyzer:change-me-long-random@db:5432/analyzer

# --- Secrets ---------------------------------------------------------------
# Signs user sessions. openssl rand -hex 32
JWT_SECRET=change-me-32-bytes-hex
# Shared by api <-> wa so the WhatsApp service accepts no outside caller.
INTERNAL_TOKEN=change-me-32-bytes-hex
# n8n must present this to write AI results back. openssl rand -hex 32
N8N_WEBHOOK_SECRET=change-me-32-bytes-hex

# --- Onboarding interview model -------------------------------------------
# Runs the intake conversation that produces each org's monitoring prompt.
# Called directly from the API (outbound only), so it works before the box is
# publicly reachable — unlike n8n, which has to call back in.
# Leave blank and the app falls back to a scripted interview.
LLM_API_KEY=
# Any OpenAI-compatible endpoint. For Anthropic use:
#   LLM_BASE_URL=https://api.anthropic.com/v1  LLM_MODEL=claude-sonnet-5
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# --- n8n (free cloud instance) --------------------------------------------
# Production webhook URL of the analysis workflow. Every inbound/outbound
# WhatsApp message is POSTed here for AI scoring.
N8N_ANALYZE_URL=https://YOUR-INSTANCE.app.n8n.cloud/webhook/analyze-message
# Where n8n posts its verdict back to. Used only in the n8n workflow config.
# https://APP_DOMAIN/api/hooks/n8n/alert

# --- Push (FCM v1, free) ---------------------------------------------------
# Path inside the api container to the Firebase service-account JSON.
# Messaging is the only Firebase product still used, and it has no paid tier.
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
FCM_PROJECT_ID=

# --- Behaviour -------------------------------------------------------------
# Container network MTU. Leave unset on a normal server (defaults to 1500).
# Set it to the host uplink MTU when running inside WSL2, a VPN, or a nested
# VM — check with: cat /sys/class/net/eth0/mtu
# DOCKER_MTU=1420

NODE_ENV=production
LOG_LEVEL=info
# How often the SLA/cold-lead worker sweeps, in seconds.
WORKER_INTERVAL_SECONDS=60
